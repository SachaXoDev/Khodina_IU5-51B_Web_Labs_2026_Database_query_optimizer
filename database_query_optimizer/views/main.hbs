<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <title>{{title}}</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <main>
    {{> header }}

    <!-- Форма отправки POST-запроса -->
    <form action="/bmstu-hello" method="POST" style="margin-bottom: 20px;">
      <input type="text" name="query" placeholder="Введите запрос" value="{{data.query}}">
      <button type="submit">Найти</button>
    </form>

    <h2>Список заказов на {{ data.current_date }}</h2>

    <ul>
      {{#each data.orders}}
        <li><a href="/bmstu-hello/order/{{this.id}}">{{this.title}}</a></li>
      {{else}}
        <li>Ничего не найдено</li>
      {{/each}}
    </ul>
  </main>
</body>
</html>
