<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>{{title}}</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Funnel+Display:wght@700;800&family=Geist+Mono:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    .figma-upload-zone {
      cursor: pointer;
      user-select: none;
    }
    .upload-active {
      border-color: #1fdc6f !important;
      background-color: rgba(31, 220, 111, 0.08) !important;
    }
    .upload-filename {
      font-size: 11px;
      color: #1fdc6f;
      margin-top: 4px;
      word-break: break-all;
      max-width: 130px;
      text-align: center;
      display: block;
    }
  </style>
</head>
<body>

  <div class="phone-screen">
    <!-- iOS статус-бар -->
    {{> statusbar }}

    <!-- Шапка экрана -->
    <header class="mobile-header">
      <div class="header-logo-group">
        <span class="brand-logo-text">DB OPTIMIZER</span>
        <span class="header-pipe">|</span>
        <span class="service-name">B-tree Creator</span>
      </div>
    </header>

    <!-- Основной контент страницы создания (точно по макету Figma) -->
    <main class="creator-container">
      {{#if hasDraft}}
        <!-- ЭТАП 2: Черновик уже существует -> Заполнение описания, двух полей по теме и кнопка ОПУБЛИКОВАТЬ -->
        <form action="/database-indexes/{{draft.id}}/publish" method="POST" class="creator-form">
          <input type="hidden" name="indexType" value="B-Tree" />

          <!-- 1. Секция: Медиа-файлы (по умолчанию на SSR сервере по ТЗ) -->
          <div class="figma-section-block">
            <div class="figma-section-title">Медиа-файлы</div>
            <div class="figma-card-box">
              <div class="figma-media-grid">
                <div class="figma-upload-zone" style="border-color: #1fdc6f; background: rgba(31,220,111,0.05);">
                  <div class="figma-upload-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#1fdc6f" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                      <circle cx="8.5" cy="8.5" r="1.5"/>
                      <polyline points="21 15 16 10 5 21"/>
                    </svg>
                  </div>
                  <span class="figma-upload-text" style="color:#1fdc6f;">default_index.svg</span>
                </div>

                <div class="figma-upload-zone" style="border-color: #1fdc6f; background: rgba(31,220,111,0.05);">
                  <div class="figma-upload-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#1fdc6f" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <polygon points="23 7 16 12 23 17 23 7"/>
                      <rect x="1" y="5" width="15" height="14" rx="2" ry="2"/>
                    </svg>
                  </div>
                  <span class="figma-upload-text" style="color:#1fdc6f;">default_video.mp4</span>
                </div>
              </div>
            </div>
          </div>

          <!-- 2. Секция: Основная информация -->
          <div class="figma-section-block">
            <div class="figma-section-title">Основная информация</div>
            <div class="figma-card-box">
              <div class="figma-field-item">
                <label for="indexName" class="figma-field-label">Название индекса</label>
                <input type="text" id="indexName" name="indexName" class="figma-input font-mono" value="{{draft.indexName}}" required />
              </div>
              <div class="figma-field-item">
                <label for="shortDescription" class="figma-field-label">Краткое описание (информация)</label>
                <input type="text" id="shortDescription" name="shortDescription" class="figma-input" placeholder="Оптимизация поиска по email, исключение Seq Scan" value="{{draft.shortDescription}}" required />
              </div>
              <div class="figma-field-item">
                <label for="fullDescription" class="figma-field-label">Полное описание</label>
                <input type="text" id="fullDescription" name="fullDescription" class="figma-input font-mono" placeholder="SELECT * FROM table WHERE column = $1;" value="{{draft.fullDescription}}" />
              </div>
            </div>
          </div>

          <!-- 3. Секция: Спецификация B-Tree (Два поля по теме) -->
          <div class="figma-section-block">
            <div class="figma-section-title">Спецификация B-Tree</div>
            <div class="figma-card-box">
              <div class="figma-grid-2col">
                <div class="figma-field-item">
                  <label for="tableName" class="figma-field-label">Таблица</label>
                  <input type="text" id="tableName" name="tableName" class="figma-input font-mono" placeholder="users" value="{{draft.tableName}}" required />
                </div>
                <div class="figma-field-item">
                  <label for="columnName" class="figma-field-label">Колонка</label>
                  <input type="text" id="columnName" name="columnName" class="figma-input font-mono" placeholder="email" value="{{draft.columnName}}" required />
                </div>
                <div class="figma-field-item">
                  <label for="scanCostReductionPercent" class="figma-field-label">Снижение стоимости (%)</label>
                  <input type="text" id="scanCostReductionPercent" name="scanCostReductionPercent" class="figma-input font-mono" placeholder="95.0" value="{{draft.scanCostReductionPercent}}" />
                </div>
                <div class="figma-field-item">
                  <label for="cardinality" class="figma-field-label">Cardinality</label>
                  <input type="number" id="cardinality" name="cardinality" class="figma-input font-mono" placeholder="1 250 000" value="{{draft.cardinality}}" />
                </div>
              </div>
            </div>
          </div>

          <!-- Кнопка Опубликовать -->
          <div style="padding: 16px 0 30px;">
            <button type="submit" class="btn-create-submit">
              <span>Опубликовать</span>
            </button>
          </div>

        </form>

      {{else}}
        <!-- ЭТАП 1: Черновика нет -> Название, фото, видео и кнопка ДАЛЕЕ -->
        <form action="/database-indexes/create" method="POST" class="creator-form">
          <input type="hidden" name="indexType" value="B-Tree" />

          <!-- 1. Секция: Медиа-файлы -->
          <div class="figma-section-block">
            <div class="figma-section-title">Медиа-файлы</div>
            <div class="figma-card-box">
              <div class="figma-media-grid">
                <label class="figma-upload-zone" id="imageDropZone" for="imageUpload">
                  <input type="file" id="imageUpload" class="file-input-hidden" accept="image/*" />
                  <div class="figma-upload-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                      <circle cx="8.5" cy="8.5" r="1.5"/>
                      <polyline points="21 15 16 10 5 21"/>
                    </svg>
                  </div>
                  <span class="figma-upload-text" id="imageText">Выбрать изображение</span>
                  <span class="upload-filename" id="imageName"></span>
                </label>

                <label class="figma-upload-zone" id="videoDropZone" for="videoUpload">
                  <input type="file" id="videoUpload" class="file-input-hidden" accept="video/*" />
                  <div class="figma-upload-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <polygon points="23 7 16 12 23 17 23 7"/>
                      <rect x="1" y="5" width="15" height="14" rx="2" ry="2"/>
                    </svg>
                  </div>
                  <span class="figma-upload-text" id="videoText">Выбрать видеоролик</span>
                  <span class="upload-filename" id="videoName"></span>
                </label>
              </div>
            </div>
          </div>

          <!-- 2. Секция: Основная информация -->
          <div class="figma-section-block">
            <div class="figma-section-title">Основная информация</div>
            <div class="figma-card-box">
              <div class="figma-field-item">
                <label for="indexName" class="figma-field-label">Название индекса</label>
                <input type="text" id="indexName" name="indexName" class="figma-input font-mono" placeholder="idx_users_email" required />
              </div>
            </div>
          </div>

          <!-- Кнопка Далее -->
          <div style="padding: 16px 0 30px;">
            <button type="submit" class="btn-create-submit">
              <span>Далее</span>
            </button>
          </div>

        </form>
      {{/if}}
    </main>

    <!-- Нижняя панель навигации (Tabbar) -->
    {{> tabbar activeTab=activeTab }}
  </div>

  <script>
    const imgInput = document.getElementById('imageUpload');
    const imgZone = document.getElementById('imageDropZone');
    const imgText = document.getElementById('imageText');
    const imgName = document.getElementById('imageName');

    if (imgInput) {
      imgInput.addEventListener('change', (e) => {
        if (e.target.files && e.target.files[0]) {
          imgZone.classList.add('upload-active');
          imgText.textContent = 'Выбрано:';
          imgName.textContent = e.target.files[0].name;
        }
      });
    }

    const videoInput = document.getElementById('videoUpload');
    const videoZone = document.getElementById('videoDropZone');
    const videoText = document.getElementById('videoText');
    const videoName = document.getElementById('videoName');

    if (videoInput) {
      videoInput.addEventListener('change', (e) => {
        if (e.target.files && e.target.files[0]) {
          videoZone.classList.add('upload-active');
          videoText.textContent = 'Выбрано:';
          videoName.textContent = e.target.files[0].name;
        }
      });
    }
  </script>
</body>
</html>
