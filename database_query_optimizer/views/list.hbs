<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}}</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Funnel+Display:wght@700;800&family=Geist+Mono:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    /* Кнопка логического удаления карточки (в фирменном стиле приложения) */
    .tile-delete-btn {
      position: absolute;
      top: 8px;
      left: 8px;
      background: rgba(18, 20, 26, 0.75);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
      border: 1px solid rgba(255, 255, 255, 0.22);
      border-radius: 50%;
      width: 26px;
      height: 26px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      color: rgba(255, 255, 255, 0.85);
      transition: all 0.15s ease;
      z-index: 5;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.6);
      padding: 0;
    }
    .tile-delete-btn:hover {
      background: rgba(30, 34, 42, 0.95);
      color: #1fdc6f;
      border-color: #1fdc6f;
      transform: scale(1.08);
    }
    .tile-delete-btn:active {
      transform: scale(0.94);
    }
    .tile-card-wrapper {
      position: relative;
      display: flex;
      flex-direction: column;
      height: 100%;
    }
    .tile-card-wrapper .tile-card {
      height: 100%;
      flex: 1;
    }
  </style>
</head>
<body>

  <div class="phone-screen">
    <!-- iOS статус-бар -->
    {{> statusbar }}

    <!-- Шапка экрана -->
    <header class="mobile-header">
      <div class="header-logo-group">
        <span class="brand-logo-text">DB OPTIMIZER</span>
        <span class="header-pipe">|</span>
        <span class="service-name">B-tree Catalog</span>
      </div>
    </header>

    <!-- Основной контент каталога -->
    <main class="page-scrollable">
      <div class="content-padding">

        <!-- Фильтрация / Поиск по Cardinality числами слайдером -->
        <form action="/database-indexes/list" method="GET" class="filter-cardinality-box">
          <div class="search-form-row">
            <div class="search-input-box">
              <input 
                type="number" 
                id="num-query" 
                name="query" 
                value="{{query}}" 
                min="0" 
                max="10000000" 
                step="50000"
                placeholder="Поиск по cardinality..."
                class="search-input-field"
                oninput="syncSliderFromInput(this.value)"
              />
            </div>

            <button type="submit" class="btn-search-action">Найти</button>
          </div>

          <!-- Числовой слайдер (ползунок) диапазона Cardinality -->
          <div class="slider-row">
            <input 
              type="range" 
              id="slider-query" 
              min="0" 
              max="5000000" 
              step="50000" 
              value="{{#if query}}{{query}}{{else}}0{{/if}}"
              class="cardinality-range-slider"
              oninput="syncInputFromSlider(this.value)"
            />
            <div class="slider-scale-labels">
              <span>0</span>
              <span>1.5M</span>
              <span>3M</span>
              <span>5M+</span>
            </div>
          </div>
        </form>

        <script>
          function syncInputFromSlider(val) {
            const input = document.getElementById('num-query');
            input.value = val;
          }
          function syncSliderFromInput(val) {
            const slider = document.getElementById('slider-query');
            if (val !== '' && !isNaN(val)) {
              slider.value = Math.min(5000000, Math.max(0, parseInt(val, 10)));
            }
          }
        </script>

        <!-- Плитка в 2 столбца (Только опубликованные услуги) -->
        <div class="index-grid-2col">
          {{#each data}}
            <div class="tile-card-wrapper">
              <!-- Кнопка логического удаления через SQL КУРСОР (WHERE CURRENT OF) -->
              <form action="/database-indexes/{{this.id}}/delete" method="POST" onsubmit="return confirm('Логически удалить услугу {{this.indexName}}?');">
                <button type="submit" class="tile-delete-btn" title="Логически удалить услугу (SQL КУРСОР)">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                </button>
              </form>

              <a href="/database-indexes/feed?id={{this.id}}" class="tile-card">
                <!-- Изображение -->
                <div class="tile-image-wrapper">
                  <img src="{{this.imageUrl}}" alt="{{this.indexName}}" class="tile-image" onerror="this.onerror=null; this.src='/assets/default_index.svg';">
                  
                  <!-- Количество лайков (из БД) -->
                  {{#if this.isLikedByMe}}
                    <div class="tile-likes-badge liked">
                      <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="#1ee46a" stroke="#1ee46a" stroke-width="2">
                        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                      </svg>
                      <span>{{this.likesCount}}</span>
                    </div>
                  {{else}}
                    <div class="tile-likes-badge unliked">
                      <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.8)" stroke-width="2">
                        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                      </svg>
                      <span>{{this.likesCount}}</span>
                    </div>
                  {{/if}}
                </div>

                <!-- Название -->
                <div class="tile-info">
                  <h3 class="tile-title" title="{{this.indexName}}">{{this.indexName}}</h3>
                  <span class="tile-subtitle">{{this.tableName}}.{{this.indexedColumn}}</span>
                  <span class="tile-time">Cardinality: {{this.formattedCardinality}}</span>
                </div>
              </a>
            </div>
          {{else}}
            <div class="empty-state-box" style="grid-column: span 2;">
              <p>Опубликованные индексы по запросу не найдены.</p>
              <a href="/database-indexes/list" class="btn-link-reset">Сбросить фильтр</a>
            </div>
          {{/each}}
        </div>

      </div>
    </main>

    <!-- Нижняя панель навигации (Tabbar) -->
    {{> tabbar activeTab=activeTab }}
  </div>

</body>
</html>
